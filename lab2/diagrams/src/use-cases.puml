@startuml use-cases
title Диаграмма сценариев использования — Система управления задачами команды

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Сотрудник"      as employee
actor "Руководитель"   as manager
actor "Администратор"  as admin

rectangle "Система управления задачами" {
    usecase "Просмотр своих задач"          as UC1
    usecase "Обновление статуса задачи"     as UC2
    usecase "Добавление комментария"        as UC3
    usecase "Просмотр отчёта о работе"      as UC4

    usecase "Создание проекта"              as UC5
    usecase "Создание и назначение задачи"  as UC6
    usecase "Просмотр загруженности команды" as UC7
    usecase "Просмотр статистики проекта"   as UC8

    usecase "Управление пользователями"     as UC9
    usecase "Просмотр истории изменений"    as UC10
    usecase "Резервное копирование"         as UC11

    usecase "Отправка уведомления\n(автоматически)" as UC12
}

employee --> UC1
employee --> UC2
employee --> UC3
employee --> UC4

manager --> UC5
manager --> UC6
manager --> UC7
manager --> UC8
manager --> UC2 : может изменять\nстатус любой задачи

admin --> UC9
admin --> UC10
admin --> UC11

UC2 ..> UC12 : <<include>>
UC6 ..> UC12 : <<include>>

@enduml
